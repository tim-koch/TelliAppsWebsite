(security) {
  encode zstd gzip
  @immutable path /_astro/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  @media path /assets/* /media/*
  header @media Cache-Control "public, max-age=604800"
  header {
    -Server
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'"
  }
}

telli-apps.de {
  redir https://www.telli-apps.de{uri} permanent
}

www.telli-apps.de {
  import security
  root * /srv

  reverse_proxy /api/forms/* form-api:3000

  @planteller path_regexp planteller ^/planteller(?:/(.*))?$
  redir @planteller https://planteller.telli-apps.de/{re.planteller.1} permanent
  @planparty path_regexp planparty ^/planparty(?:/(.*))?$
  redir @planparty https://planparty.telli-apps.de/{re.planparty.1} permanent

  try_files {path} {path}/index.html =404
  file_server
  handle_errors {
    rewrite * /404.html
    file_server
  }
}

planteller.telli-apps.de {
  import security

  reverse_proxy /api/forms/* form-api:3000

  @site_meta path /planteller/favicon.png /planteller/apple-touch-icon.png /planteller/site.webmanifest
  handle @site_meta {
    uri strip_prefix /planteller
    root * /srv/planteller
    file_server
  }

  @shared path /_astro/* /assets/* /media/*
  handle @shared {
    root * /srv
    file_server
  }

  handle {
    root * /srv/planteller
    @recipe path /recipe-share/*
    rewrite @recipe /recipe-share/index.html
    @collection path /collection-share/*
    rewrite @collection /collection-share/index.html
    @invite path /invite/*
    rewrite @invite /invite/index.html
    @reset path /reset-password/*
    rewrite @reset /reset-password/index.html
    try_files {path} {path}/index.html =404
    file_server
  }

  handle_errors {
    root * /srv/planteller
    rewrite * /404/index.html
    file_server
  }
}

planparty.telli-apps.de {
  import security

  reverse_proxy /api/forms/* form-api:3000

  @site_meta path /planparty/favicon.png /planparty/apple-touch-icon.png /planparty/site.webmanifest
  handle @site_meta {
    uri strip_prefix /planparty
    root * /srv/planparty
    file_server
  }

  @shared path /_astro/* /assets/* /media/*
  handle @shared {
    root * /srv
    file_server
  }

  handle {
    root * /srv/planparty
    try_files {path} {path}/index.html =404
    file_server
  }

  handle_errors {
    root * /srv/planparty
    rewrite * /404/index.html
    file_server
  }
}
