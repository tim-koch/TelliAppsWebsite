---
import { getImage, Picture } from "astro:assets";

/* global ImageMetadata */

interface GalleryItem {
  src: ImageMetadata;
  title: string;
  text: string;
}

interface Props {
  appName: string;
  items: readonly GalleryItem[];
  ratio: "planteller" | "planparty";
}

const { appName, items, ratio } = Astro.props;
const dialogTitleId = `${appName.toLowerCase()}-screenshot-dialog-title`;
const optimizedItems = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: await getImage({
      src: item.src,
      width: Math.min(item.src.width, 1080),
      format: "webp",
      quality: 90,
    }),
  })),
);
---

<div class="screenshot-carousel" data-screenshot-carousel>
  <div
    class="screenshot-gallery"
    role="region"
    aria-label={`${appName} App-Screenshots – horizontal scrollbar`}
    tabindex="0"
    data-screenshot-track
  >
    {
      optimizedItems.map(({ src, title, text, full }, index) => (
        <figure class="screenshot-card" data-reveal>
          <button
            type="button"
            class:list={["screenshot-card__image", `screenshot-card__image--${ratio}`]}
            data-screenshot-open
            data-full-src={full.src}
            data-title={title}
            data-text={text}
            data-alt={`${appName} ${title}`}
            aria-haspopup="dialog"
            aria-label={`Groß ansehen: ${appName} Ansicht „${title}“`}
          >
            <Picture
              src={src}
              alt={`${appName} ${title}`}
              formats={["avif", "webp"]}
              widths={[280, 360, 540, 720]}
              sizes="(max-width: 600px) 72vw, 17.5rem"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="screenshot-card__zoom">Groß ansehen</span>
          </button>
          <figcaption>
            <strong>{title}</strong>
            <span>{text}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="screenshot-carousel__controls" aria-label="Screenshot-Navigation">
    <button
      type="button"
      data-screenshot-previous
      aria-label="Vorherigen Screenshot zeigen"
    >
      <span aria-hidden="true">←</span> Zurück
    </button>
    <p>Wischen, scrollen oder groß ansehen</p>
    <button type="button" data-screenshot-next aria-label="Nächsten Screenshot zeigen">
      Weiter <span aria-hidden="true">→</span>
    </button>
  </div>
  <dialog
    class="screenshot-lightbox"
    data-screenshot-dialog
    aria-labelledby={dialogTitleId}
  >
    <div class="screenshot-lightbox__surface">
      <header class="screenshot-lightbox__header">
        <p>
          <span>{appName} · App-Einblick</span>
          <strong id={dialogTitleId} data-lightbox-title>Screenshot</strong>
        </p>
        <button type="button" class="screenshot-lightbox__close" data-lightbox-close>
          <span aria-hidden="true">×</span>
          <span class="sr-only">Bildansicht schließen</span>
        </button>
      </header>
      <figure class="screenshot-lightbox__figure">
        <img alt="" data-lightbox-image />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
      <nav class="screenshot-lightbox__navigation" aria-label="Bilder durchblättern">
        <button type="button" data-lightbox-previous>
          <span aria-hidden="true">←</span> Vorheriges Bild
        </button>
        <button type="button" data-lightbox-next>
          Nächstes Bild <span aria-hidden="true">→</span>
        </button>
      </nav>
    </div>
  </dialog>
</div>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>(
    "[data-screenshot-carousel]",
  )) {
    const track = carousel.querySelector<HTMLElement>("[data-screenshot-track]");
    const previous = carousel.querySelector<HTMLButtonElement>(
      "[data-screenshot-previous]",
    );
    const next = carousel.querySelector<HTMLButtonElement>("[data-screenshot-next]");
    const dialog = carousel.querySelector<HTMLDialogElement>("[data-screenshot-dialog]");
    const openButtons = [
      ...carousel.querySelectorAll<HTMLButtonElement>("[data-screenshot-open]"),
    ];
    const lightboxImage = dialog?.querySelector<HTMLImageElement>(
      "[data-lightbox-image]",
    );
    const lightboxTitle = dialog?.querySelector<HTMLElement>("[data-lightbox-title]");
    const lightboxCaption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const lightboxPrevious = dialog?.querySelector<HTMLButtonElement>(
      "[data-lightbox-previous]",
    );
    const lightboxNext = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-next]");

    if (
      !track ||
      !previous ||
      !next ||
      !dialog ||
      !lightboxImage ||
      !lightboxTitle ||
      !lightboxCaption ||
      !close ||
      !lightboxPrevious ||
      !lightboxNext ||
      !openButtons.length ||
      carousel.dataset.ready
    )
      continue;
    carousel.dataset.ready = "true";
    let activeIndex = 0;
    let activeTrigger: HTMLButtonElement | undefined;

    const move = (direction: number) => {
      const card = track.querySelector<HTMLElement>(".screenshot-card");
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 16;
      track.scrollBy({
        left: direction * ((card?.offsetWidth ?? track.clientWidth * 0.88) + gap),
        behavior: "smooth",
      });
    };

    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));

    const updateDialog = () => {
      const trigger = openButtons[activeIndex];
      if (!trigger) return;
      const fullSource = trigger.dataset.fullSrc || "";
      const previewSource = trigger.querySelector<HTMLImageElement>("img")?.currentSrc;
      lightboxImage.src = previewSource || fullSource;
      lightboxImage.alt = trigger.dataset.alt || "";
      lightboxTitle.textContent = trigger.dataset.title || "Screenshot";
      lightboxCaption.textContent = trigger.dataset.text || "";

      if (previewSource && fullSource && previewSource !== fullSource) {
        const requestedIndex = activeIndex;
        const fullImage = new Image();
        fullImage.addEventListener(
          "load",
          () => {
            if (activeIndex === requestedIndex) lightboxImage.src = fullSource;
          },
          { once: true },
        );
        fullImage.src = fullSource;
      }
    };

    const show = (index: number) => {
      activeIndex = (index + openButtons.length) % openButtons.length;
      activeTrigger = openButtons[activeIndex];
      updateDialog();
      if (!dialog.open) dialog.showModal();
      close.focus({ preventScroll: true });
    };

    openButtons.forEach((button, index) => {
      button.addEventListener("click", () => show(index));
    });
    close.addEventListener("click", () => dialog.close());
    lightboxPrevious.addEventListener("click", () => show(activeIndex - 1));
    lightboxNext.addEventListener("click", () => show(activeIndex + 1));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(activeIndex - 1);
      if (event.key === "ArrowRight") show(activeIndex + 1);
    });
    dialog.addEventListener("close", () => activeTrigger?.focus({ preventScroll: true }));
  }
</script>
