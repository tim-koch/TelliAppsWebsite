---
interface Props {
  appName: string;
  source: string;
  poster: string;
  transcript: string[];
}

const { appName, source, poster, transcript } = Astro.props;
---

<div class="demo-video">
  <video
    controls
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    aria-label={`${appName} in einer kurzen App-Vorschau`}
  >
    <source src={source} type="video/webm" />
    Dein Browser kann das Vorschauvideo nicht wiedergeben.
  </video>
  <details>
    <summary>Textbeschreibung des Videos</summary>
    <ol>{transcript.map((item) => <li>{item}</li>)}</ol>
  </details>
</div>
