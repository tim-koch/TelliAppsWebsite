---
const src = import.meta.env.PUBLIC_UMAMI_SRC;
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const pagesOrigin = import.meta.env.PUBLIC_GITHUB_PAGES_ORIGIN;
const trackedDomains = pagesOrigin
  ? new URL(pagesOrigin).hostname
  : "www.telli-apps.de,planteller.telli-apps.de,planparty.telli-apps.de";
---

{
  src && websiteId && (
    <script
      is:inline
      async
      defer
      src={src}
      data-website-id={websiteId}
      data-do-not-track="true"
      data-domains={trackedDomains}
    />
  )
}
