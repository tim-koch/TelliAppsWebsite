---
import { Picture } from "astro:assets";
import planPartyIcon from "../assets/planparty/icon.png";
import planTellerIcon from "../assets/planteller/icon.png";
import type { SiteConfig } from "../config/sites";

interface Props {
  site: SiteConfig;
  compact?: boolean;
  hero?: boolean;
}

const { site, compact = false, hero = false } = Astro.props;
---

<span
  class:list={[
    "brand-logo",
    compact && "brand-logo--compact",
    hero && "brand-logo--hero",
  ]}
>
  {
    site.id === "telliapps" ? (
      <svg class="brand-logo__mark" viewBox="0 0 48 48" aria-hidden="true">
        <rect x="17" y="17" width="27" height="27" rx="8" class="brand-logo__secondary" />
        <path
          d="M25 25v12m0-12h12m-12 6h9m-9 6h12"
          class="brand-logo__line brand-logo__line--secondary"
        />
        <rect x="4" y="4" width="27" height="27" rx="8" class="brand-logo__primary" />
        <path d="M11 13h13M17.5 13v11" class="brand-logo__line" />
      </svg>
    ) : (
      <Picture
        class="brand-logo__picture"
        src={site.id === "planteller" ? planTellerIcon : planPartyIcon}
        alt=""
        formats={["avif", "webp"]}
        widths={[48, 96]}
        sizes={hero ? "7rem" : "2.25rem"}
        loading="eager"
      />
    )
  }
  <span
    class:list={[
      "brand-logo__text",
      site.id === "telliapps" && "brand-logo__text--telliapps",
    ]}
  >
    {
      site.id === "telliapps" ? (
        <>
          <span>Telli</span>
          <span>Apps</span>
        </>
      ) : (
        site.name
      )
    }
  </span>
</span>
