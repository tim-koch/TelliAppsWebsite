{
  "name": "telliapps-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve:test": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:links": "linkinator dist --recurse --clean-urls --check-fragments --skip \"^(mailto:|tel:|planteller:|https://)\"",
    "test:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "media:build": "node scripts/create-og-images.mjs && node scripts/create-demo-videos.mjs",
    "qa:screenshots": "node scripts/capture-quality-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "linkinator": "^7.6.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
